#!/usr/bin/env bash
set -e

# Ensure /etc/ssl/certs has hashed symlinks for Cisco HostScan cstub on existing bootc installs
if ! ls /etc/ssl/certs/*.0 >/dev/null 2>&1; then
    echo "Initializing /etc/ssl/certs for Cisco HostScan (one-time setup)..."
    sudo bash -c 'csplit -s -z -f /etc/ssl/certs/ca- -b "%03d.pem" /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem "/-----BEGIN CERTIFICATE-----/" "{*}" && openssl rehash /etc/ssl/certs'
fi

if ! /usr/bin/openconnect-sso \
  --server ://rexelusa.com \
  --ac-version 5.1.7.80 \
  -- \
  --csd-wrapper=/usr/libexec/openconnect/csd-wrapper.sh \
  --os=linux-64; then
    echo ""
    read -rp "Rexel VPN exited with an error. Press Enter to close..."
fi
